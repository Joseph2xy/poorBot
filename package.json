{
  "name": "poorbot",
  "description": "PoorBot: Discord game-price tracking with cumulative price-drop alerts and an offline demo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joseph2xy/poorbot.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "demo": "node demo.ts",
    "start": "node --env-file-if-exists=.env bot.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test *.test.ts"
  },
  "engines": {
    "node": ">=24.12"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "discord.js": "14.27.0"
  },
  "license": "MIT"
}
